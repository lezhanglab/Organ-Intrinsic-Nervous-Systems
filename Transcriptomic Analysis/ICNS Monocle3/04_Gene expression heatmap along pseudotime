library(dplyr)
library(cluster)
library(Seurat)
library(dplyr)
library(ggplot2)
library(cowplot)
library(RColorBrewer)
library(gridExtra)
library(colorRamp2)
library(ComplexHeatmap)
library(GetoptLong)

ss_cluster <- readRDS("ss_cluster_PrecursortoNeuroblast.rds")

gene_ts <- readRDS("PrecursortoNeuroblast_final_time_expN.rds")

time <- gene_ts$time %>% as.data.frame()

ha = rowAnnotation(foo = anno_mark(at = c(609,315,369,332,311,339,587,360,
                                          300,130,253,204,312,357,1318,1364,1421,1395,1404,1413,
                                          1688,2716,2017,1079,1132,1084,1668,1088,1611,2057,2047,
                                          2726,2292,1490,1496,527,1453,1463), 
                                   labels = c("Serpine2","Itga4","Ednrb","Sox10","Erbb3","Foxd3","Ets1","Plp1",
                                              "Col1a2","Dusp6","Tnc","Itgb1","Lama2","Col18a1","Ascl1",
                                              "Itga1","Gata3","Lef1","Tbx20","Plxna4",
                                              "Cux2","Sv2c","Ntrk3","Igf1r",
                                              "Acvr2b","Tox3","Aff2","Insm1",
                                              "Epha5","Cntn5","Isl1","Ncam1","Syt11",
                                              "L1cam",
                                              "Nrp1","Notch1","Cd47","Nlgn1")))

data <- gene_ts[,-1]
data <- t(data) %>% as.data.frame()
data$label <- factor(ss_cluster$ss_cluster,levels = c(12,10,6,8,2,7,4,9,13,11,1,3,5))
data <- data %>%
  arrange(label)
label <- data$label
data <- data[,-2955]
write.csv(data, "data.csv", row.names = T)
data <- read.csv("data.csv")
col_fun <- colorRamp2(c(min(time),max(time)),c("white","blue"))
pt <- time$.
colAnn <- HeatmapAnnotation(pseudotime=as.numeric(pt),
                            col = list(pseudotime=col_fun))
rolAnn <- rowAnnotation(cluster = as.character(label),show_legend = FALSE)

myCol1 <- colorRampPalette(c("steelblue1","white","red"))(300)
myBreaks1 <- seq(min(data),max(data), length.out=300)
ht=Heatmap(as.matrix(data),col = colorRamp2(myBreaks1, myCol1),top_annotation = colAnn,
           show_row_names=FALSE,show_column_names =FALSE,cluster_columns = F,cluster_rows = F,
           left_annotation = rolAnn, right_annotation = ha)
draw(ht)
dev.off()


