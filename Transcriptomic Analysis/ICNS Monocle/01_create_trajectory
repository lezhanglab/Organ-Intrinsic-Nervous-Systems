library(SeuratWrappers)
library(monocle3)
library(Seurat)
library(ggplot2)
library(patchwork)
library(magrittr)
library(htmlwidgets)
library(Signac)

##1 Choose the root population for the trajectories
ICN.npc <- readRDS(file = "ICN.npc.rds") #ICN.npc contains integration of E12.5, E14.5 and E16.5 scRNA-seq datasets.
DimPlot(object = ICN.npc, reduction = 'umap', label = TRUE, split.by = "age")

#### find root population
#DefaultAssay(ICN.npc) <- "integrated"
#ICN.npc <- FindClusters(ICN.npc, resolution = 4)
DefaultAssay(ICN.npc) <- "RNA"
############################
FeaturePlot(ICN.npc,c("Sox10","Mki67"),label = T) #Cluster 1 and 4 are progenitors. Cluster 4 is proliferating
VlnPlot(ICN.npc,"Mki67") 
VlnPlot(ICN.npc,"Snap25") 
VlnPlot(ICN.npc,"Sox10") 
VlnPlot(ICN.npc,"Phox2b")
VlnPlot(ICN.npc,"Mef2c") 
VlnPlot(ICN.npc,"Itga4")
VlnPlot(ICN.npc,"Ednrb")
############################
root_pop <- subset(ICN.npc, seurat_clusters %in% c("1"))
Idents(ICN.npc) <- "orig.ident"
levels(ICN.npc)
root_pop <- subset(root_pop,orig.ident %in% c("ICN.E12.1","ICN.E12.2"))
VlnPlot(root_pop,c("Sox10","Kif20a","Ednrb","Itga4"))
FeaturePlot(root_pop,"Sox10",label = T)
root_pop <- subset(root_pop,Sox10 > 2)

head(ICN.npc[[]])
ICN.npc$root = ICN.npc$orig.ident
ICN.npc$root[cells = WhichCells(ICN.npc)]<- 'daughters'
ICN.npc$root[cells = WhichCells(root_pop)]<- 'root'
Idents(ICN.npc) <- 'root'
DimPlot(object = ICN.npc, reduction = 'umap', label = TRUE, split.by = "root")
saveRDS(root_pop, file ="root.rds")
############################

## Create monocle trajectories in 2D
DefaultAssay(ICN.npc) <-"RNA"
cds <- as.cell_data_set(ICN.npc)
cds@reduce_dim_aux@listData[["UMAP"]] <-ICN.npc@reductions[["umap"]]@cell.embeddings
cds@reduce_dim_aux$gene_loadings <- ICN.npc@reductions[["pca"]]@feature.loadings
cds <- cluster_cells(cds, reduction_method = "UMAP")
cds <- learn_graph(cds, learn_graph_control = list("minimal_branch_len"=3), close_loop = FALSE, use_partition = TRUE)
cds <- order_cells(cds, reduction_method = "UMAP", root_cells = colnames(root_pop))
plot_cells(
  cds,
  x = 1,
  y = 2,
  reduction_method = c("UMAP", "tSNE", "PCA", "LSI", "Aligned"),
  color_cells_by = "pseudotime",
  group_cells_by = c("cluster", "partition"),
  genes = NULL,
  show_trajectory_graph = TRUE,
  trajectory_graph_color = "grey28",
  trajectory_graph_segment_size = 0.5,
  norm_method = c("log", "size_only"),
  label_cell_groups = F,
  label_groups_by_cluster = F,
  group_label_size = 2,
  labels_per_group = 1,
  label_branch_points = F,
  label_roots = F,
  label_leaves = F,
  graph_label_size = 2,
  alpha = 1,
  min_expr = 0.1,
  rasterize = FALSE,
  scale_to_range = TRUE,
  label_principal_points = FALSE
)

# select Precursor to Neuroblast branch 
cds_subset <- choose_cells(cds)

saveRDS(cds_subset,"PrecursortoNeuroblast.rds") 

plot_cells(
  cds = cds_subset,
  color_cells_by = "pseudotime",
  show_trajectory_graph = TRUE
)



