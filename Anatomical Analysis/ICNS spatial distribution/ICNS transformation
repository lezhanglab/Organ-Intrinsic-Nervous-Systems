%% Acronyms: ICNS, ICN, and ICNs are used interchangeably and refer to intrinsic cardiac neurons.

%% Reconstruct heart outlines and ICNS from immunolabeling images.
% In Fiji, open the TIFF file and apply the following steps:
% 1. Process -> Binary -> Make Binary, then choose "Percentile"
% 2. Process -> Binary -> Open
% 3. Process -> Binary -> Close
% 4. Apply Process -> Binary -> Dilate as many times as needed
% 5. Process -> Binary -> Fill Holes
% 6. Process -> Binary -> Outline
% 7. Edit -> Invert
% 8. Save the result
% This procedure produces the heart outlines.

%% Load Image stacks
Heart_Outline = tiffreadVolume('heart_Outline.tif'); %"heart_Outline.tif" is an example file name here.

%% Generate Heart Outline matrix
Heart = [];
micron_to_pixel = 0.675;
% Define the section ranges containing the atrium:
% full resolution before a1
% reduced resolution between a1 and a2, 
% low resolution below a2
a1 = 70;
a2 = 100;

for i = 1:size(Heart_Outline,3)
    A = Heart_Outline(:,:,i);
    [col,row] = find(A);
    B = [row col];
    j = length(row);
    x = 1:j;
    if i > a1
        if i > a2
            if j > 1000
                x = randi(j,fix(j/100),1);
            else
                if j > 100
                    x = randi(j,fix(j/10),1);
                end
            end
        else
            x = randi(j,fix(j/(99*(i-a1)/(a2-a1)+1)),1);
        end
    end
    B = B(x,:);
    B(:,3) = i;
    Heart = [Heart;B];
end

% Convert from pixels/section index to physical units
Heart_micron = Heart;
Heart_micron(:,1) = Heart(:,1)*micron_to_pixel;
Heart_micron(:,2) = Heart(:,2)*micron_to_pixel;
Heart_micron(:,3) = Heart(:,3) * (-10.002);

% Plot 3D heart outline
figure;
scatter3(Heart_micron(:,1),Heart_micron(:,2),Heart_micron(:,3),0.5,'ko','filled');
hold on;

%% Plot Atrial Landmarks 
Landmark_micron = Landmark;
Landmark_micron(:,3) = -Landmark_micron(:,3);

% Extract landmarks
AA = Landmark_micron(1,:); % anterior edge
PA = Landmark_micron(3,:); % posterior edge 
LAJ = Landmark_micron(2,:); % left junctions between the atrial dome and appendages
RAJ = Landmark_micron(4,:); % right junctions between the atrial dome and appendages

% plot raw landmark points

% plot AA, labeled as star
scatter3(AA(1),AA(2),AA(3),100,'cp','filled');

% plot PA, labeled as square
scatter3(PA(1),PA(2),PA(3),100,'cs','filled');

% plot LAJ, labeled as left-pointing triangle
scatter3(LAJ(1),LAJ(2),LAJ(3),100,'c<');

% plot RAJ, labeled as right-poingting triangle
scatter3(RAJ(1),RAJ(2),RAJ(3),100,'c>','filled');

%% Simulate plain S1 with all 4 landmark points
xyz0=mean(Landmark_micron,1);
centeredPlane=bsxfun(@minus,Landmark_micron,xyz0);
[U,S,V]=svd(centeredPlane);

a_S1=V(1,3);
b_S1=V(2,3);
c_S1=V(3,3);
d_S1=-dot([a_S1 b_S1 c_S1],xyz0);

S1_vertical_vector = transpose(V(:,3));

% set positive direction for S1 vector towards the top of the heart
xyz0_positive = xyz0;
xyz0_positive(:,3) = xyz0_positive(:,3)+200;
xyz0_positive_z = dot(S1_vertical_vector,xyz0_positive)+d_S1;

if xyz0_positive_z < 0
    S1_vertical_vector = -S1_vertical_vector;
    d_S1 = -d_S1;
end

S1_norm_vector = S1_vertical_vector/sqrt(dot(S1_vertical_vector,S1_vertical_vector));

% projection points on the new plane
pAA = AA - (sum(AA.*S1_vertical_vector)+d_S1)/sqrt(dot(S1_vertical_vector,S1_vertical_vector))*S1_vertical_vector;
pPA = PA - (sum(PA.*S1_vertical_vector)+d_S1)/sqrt(dot(S1_vertical_vector,S1_vertical_vector))*S1_vertical_vector;
pLAJ = LAJ - (sum(LAJ.*S1_vertical_vector)+d_S1)/sqrt(dot(S1_vertical_vector,S1_vertical_vector))*S1_vertical_vector;
pRAJ = RAJ - (sum(RAJ.*S1_vertical_vector)+d_S1)/sqrt(dot(S1_vertical_vector,S1_vertical_vector))*S1_vertical_vector;

pLandmark = [pAA;pLAJ;pPA;pRAJ];

% plot projection points, in blue

% plot pAA, labeled as star
scatter3(pAA(1),pAA(2),pAA(3),150,'bp','filled');

% plot pPA, labeled as sqaure
scatter3(pPA(1),pPA(2),pPA(3),150,'bs','filled');

% plot pLAJ, labeled as left-pointing triangle
scatter3(pLAJ(1),pLAJ(2),pLAJ(3),150,'b<');

% plot pRAJ, labeled as right-poingting triangle
scatter3(pRAJ(1),pRAJ(2),pRAJ(3),150,'b>','filled');

%% plot ICNs
ICN_raw_micron = [];
% if ICN coordinates were from the raw image
ICN_raw_micron(:,1) = ICN_raw(:,1);
% if ICN coordinates were from the inverted image
% ICN_raw_micron(:,1) = size(Heart_Outline,2)*micron_to_pixel - ICN_raw(:,1);
ICN_raw_micron(:,2) = ICN_raw(:,2);
ICN_raw_micron(:,3) = ICN_raw(:,3) * (-10.002);
ICN_raw_micron = unique(ICN_raw_micron,'rows');
ICN_number = size(ICN_raw_micron,1);
scatter3(ICN_raw_micron(:,1),ICN_raw_micron(:,2),ICN_raw_micron(:,3),30,'ro','filled');

%% Coordinate centering: Set tpAA = [0 -y 0] and tpPA = [0 y 0]
norm_factor = pdist([pAA;pPA],'euclidean');
center = (pAA+pPA)/2;

% Set plain S2 with pAA_pPA as vertical_vector 
S2_vertical_vector = pPA-pAA;
S2_norm_vector = S2_vertical_vector/sqrt(dot(S2_vertical_vector,S2_vertical_vector));
d_S2 = -dot(S2_norm_vector,center);

% Set plain S3 made by S2_vertical_vector and S1_vertical_vector
S3_vertical_vector = -cross(S1_vertical_vector, S2_vertical_vector);
S3_norm_vector = S3_vertical_vector/sqrt(dot(S3_vertical_vector,S3_vertical_vector));
d_S3 = -dot(S3_norm_vector,center);

% Calculate additional axis landmarks
X_Left = [center(1)+S3_norm_vector(1)*norm_factor center(2)+S3_norm_vector(2)*norm_factor center(3)+S3_norm_vector(3)*norm_factor];
X_Right = [center(1)-S3_norm_vector(1)*norm_factor center(2)-S3_norm_vector(2)*norm_factor center(3)-S3_norm_vector(3)*norm_factor];
Y_Anterior = [center(1)-S2_norm_vector(1)*norm_factor center(2)-S2_norm_vector(2)*norm_factor center(3)-S2_norm_vector(3)*norm_factor]
Y_Posterior = [center(1)+S2_norm_vector(1)*norm_factor center(2)+S2_norm_vector(2)*norm_factor center(3)+S2_norm_vector(3)*norm_factor]
Z_Top = [center(1)+S1_norm_vector(1)*norm_factor center(2)+S1_norm_vector(2)*norm_factor center(3)+S1_norm_vector(3)*norm_factor];
Z_Bottom = [center(1)-S1_norm_vector(1)*norm_factor center(2)-S1_norm_vector(2)*norm_factor center(3)-S1_norm_vector(3)*norm_factor];

Axesmark = [X_Left;X_Right;Y_Anterior;Y_Posterior;Z_Top;Z_Bottom];
Allmark = [Landmark_micron;pLandmark;Axesmark];

%% plot plains S1, S2, S3
% Plot 3D axes
scatter3(X_Left(1),X_Left(2),X_Left(3),200,'mo','filled');
scatter3(X_Right(1),X_Right(2),X_Right(3),200,'mo');
scatter3(Y_Anterior(1),Y_Anterior(2),Y_Anterior(3),200,'mo','filled');
scatter3(Y_Posterior(1),Y_Posterior(2),Y_Posterior(3),200,'mo');
scatter3(Z_Top(1),Z_Top(2),Z_Top(3),200,'mo','filled');
scatter3(Z_Bottom(1),Z_Bottom(2),Z_Bottom(3),200,'mo');
plot3([X_Left(1) X_Right(1)],[X_Left(2) X_Right(2)],[X_Left(3) X_Right(3)],'m-','LineWidth',2);
plot3([Y_Anterior(1) Y_Posterior(1)],[Y_Anterior(2) Y_Posterior(2)],[Y_Anterior(3) Y_Posterior(3)],'m-','LineWidth',2);
plot3([Z_Top(1) Z_Bottom(1)],[Z_Top(2) Z_Bottom(2)],[Z_Top(3) Z_Bottom(3)],'m-','LineWidth',2);

% Plot Plain S1
tx = -5:5;
ty = -5:5;
X = zeros(11,11);
Y = zeros(11,11);
for i = 1:11
    for j = 1:11
        X(i,j) = center(1)+tx(i)*S3_norm_vector(1)*norm_factor/5+ty(j)*S2_norm_vector(1)*norm_factor/5;
        Y(i,j) = center(2)+tx(i)*S3_norm_vector(2)*norm_factor/5+ty(j)*S2_norm_vector(2)*norm_factor/5;
    end
end
Z = -(d_S1+S1_norm_vector(1,1)*X+S1_norm_vector(1,2)*Y)/S1_norm_vector(1,3);
S1 = surf(X,Y,Z);
S1.FaceAlpha = 0.1;

% Plot Plain S2
tx = -5:5;
tz = -5:5;
X = zeros(11,11);
Z = zeros(11,11);
for i = 1:11
    for j = 1:11
        X(i,j) = center(1)+tx(i)*S3_norm_vector(1)*norm_factor/5+tz(j)*S1_norm_vector(1)*norm_factor/5;
        Z(i,j) = center(3)+tx(i)*S3_norm_vector(3)*norm_factor/5+tz(j)*S1_norm_vector(3)*norm_factor/5;
    end
end
Y = -(d_S2+S2_norm_vector(1,1)*X+S2_norm_vector(1,3)*Z)/S2_norm_vector(1,2);
S2 = surf(X,Y,Z);
S2.FaceAlpha = 0.1;

% Plot Plain S3
tz = -5:5;
ty = -5:5;
Z = zeros(11,11);
Y = zeros(11,11);
for i = 1:11
    for j = 1:11
        Z(i,j) = center(3)+tx(i)*S1_norm_vector(3)*norm_factor/5+ty(j)*S2_norm_vector(3)*norm_factor/5;
        Y(i,j) = center(2)+tx(i)*S1_norm_vector(2)*norm_factor/5+ty(j)*S2_norm_vector(2)*norm_factor/5;
    end
end
X = -(d_S3+S3_norm_vector(1,2)*Y+S3_norm_vector(1,3)*Z)/S3_norm_vector(1,1);
S3 = surf(X,Y,Z);
S3.FaceAlpha = 0.1;

%% Generate new ICN transformation and norm matrix
% Set coordinate matrix after transformation
tAllmark = zeros(length(Allmark),3);
tICN = zeros(ICN_number,3);
tHeart = zeros(length(Heart_micron),3);

% Calculate landmark coordinates after transformation
for i = 1:length(Allmark)
    % Calculate Z: distance from the point to plain S1
    tAllmark(i,3) = dot(S1_norm_vector,Allmark(i,:))+d_S1;
    % Calculate Y: distance from the point to plain S2
    tAllmark(i,2) = dot(S2_norm_vector,Allmark(i,:))+d_S2;
    % Calculate X: distance from the point to plain S3
    tAllmark(i,1) = dot(S3_norm_vector,Allmark(i,:))+d_S3;
end

% Calculate ICN coordinates after transformation
for i = 1:ICN_number
    % Calculate Z: distance from the point to plain S1
    tICN(i,3) = dot(S1_norm_vector,ICN_raw_micron(i,:))+d_S1;
    % Calculate Y: distance from the point to plain S2
    tICN(i,2) = dot(S2_norm_vector,ICN_raw_micron(i,:))+d_S2;
    % Calculate X: distance from the point to plain S3
    tICN(i,1) = dot(S3_norm_vector,ICN_raw_micron(i,:))+d_S3;
end

% Calculate heart coordinates after transformation
for i = 1:length(Heart_micron)
    % Calculate Z: distance from the point to plain S1
    tHeart(i,3) = dot(S1_norm_vector,Heart_micron(i,:))+d_S1;
    % Calculate Y: distance from the point to plain S2
    tHeart(i,2) = dot(S2_norm_vector,Heart_micron(i,:))+d_S2;
    % Calculate X: distance from the point to plain S3
    tHeart(i,1) = dot(S3_norm_vector,Heart_micron(i,:))+d_S3;
end

%% Make 3D plots for transformed
tAA = tAllmark(1,:);
tPA = tAllmark(3,:);
tLAJ = tAllmark(2,:);
tRAJ = tAllmark(4,:);
tpAA = tAllmark(5,:);
tpPA = tAllmark(7,:);
tpLAJ = tAllmark(6,:);
tpRAJ = tAllmark(8,:);
tX_Left = tAllmark(9,:);
tX_Right = tAllmark(10,:);
tY_Anterior = tAllmark(11,:);
tY_Posterior = tAllmark(12,:);
tZ_Top = tAllmark(13,:);
tZ_Bottom = tAllmark(14,:);

figure;
scatter3(tHeart(:,1),tHeart(:,2),tHeart(:,3),0.5,'ko','filled');
hold on;

% plot transformed raw landmark points, in cyan

% plot tAA, labeled as star
scatter3(tAA(1),tAA(2),tAA(3),100,'cp','filled');

% plot tPA, labeled as asterisk
scatter3(tPA(1),tPA(2),tPA(3),100,'cs','filled');

% plot tLAJ, labeled as left-pointing triangle
scatter3(tLAJ(1),tLAJ(2),tLAJ(3),100,'c<');

% plot tRAJ, labeled as right-poingting triangle
scatter3(tRAJ(1),tRAJ(2),tRAJ(3),100,'c>','filled');

% plot transformed projection points, in blue

% plot tpAA, labeled as star
scatter3(tpAA(1),tpAA(2),tpAA(3),150,'bp','filled');

% plot tpPA, labeled as asterisk
scatter3(tpPA(1),tpPA(2),tpPA(3),150,'bs','filled');

% plot tpLAJ, labeled as left-pointing triangle
scatter3(tpLAJ(1),tpLAJ(2),tpLAJ(3),150,'b<');

% plot tpRAJ, labeled as right-poingting triangle
scatter3(tpRAJ(1),tpRAJ(2),tpRAJ(3),150,'b>','filled');

% Plot transformed 3D axes
scatter3(tX_Left(1),tX_Left(2),tX_Left(3),200,'mo','filled');
scatter3(tX_Right(1),tX_Right(2),tX_Right(3),200,'mo');
scatter3(tY_Anterior(1),tY_Anterior(2),tY_Anterior(3),200,'mo','filled');
scatter3(tY_Posterior(1),tY_Posterior(2),tY_Posterior(3),200,'mo');
scatter3(tZ_Top(1),tZ_Top(2),tZ_Top(3),200,'mo','filled');
scatter3(tZ_Bottom(1),tZ_Bottom(2),tZ_Bottom(3),200,'mo');
plot3([tX_Left(1) tX_Right(1)],[tX_Left(2) tX_Right(2)],[tX_Left(3) tX_Right(3)],'m-','LineWidth',2);
plot3([tY_Anterior(1) tY_Posterior(1)],[tY_Anterior(2) tY_Posterior(2)],[tY_Anterior(3) tY_Posterior(3)],'m-','LineWidth',2);
plot3([tZ_Top(1) tZ_Bottom(1)],[tZ_Top(2) tZ_Bottom(2)],[tZ_Top(3) tZ_Bottom(3)],'m-','LineWidth',2);

% plot transformed ICNs
scatter3(tICN(:,1),tICN(:,2),tICN(:,3),30,'ro','filled');

% plot plains
% Plot Plain S1
t = -5:5;
X = transpose(ones(11,1).*t)*norm_factor/5;
Y = ones(11,1)*t*norm_factor/5;
Z = zeros(11,11);
S1 = surf(X,Y,Z);
S1.FaceAlpha = 0.2;

% Plot Plain S2
X = transpose(ones(11,1).*t)*norm_factor/5;
Z = ones(11,1).*t*norm_factor/5;
Y = zeros(11,11);
S2 = surf(X,Y,Z);
S2.FaceAlpha = 0.2;

% Plot Plain S3
Z = transpose(ones(11,1).*t)*norm_factor/5;
Y = ones(11,1)*t*norm_factor/5;
X = zeros(11,11);
S3 = surf(X,Y,Z);
S3.FaceAlpha = 0.2;

%% Normalize to |pAA_pPA|
tnAllmark = tAllmark/norm_factor;
tnICN = tICN/norm_factor;
tnHeart = tHeart/norm_factor;

%% Compute pairwise Euclidean distance matrix for raw ICNs
rICN_distance = squareform(pdist(ICN_raw_micron));

%% Calculate ICNS 2D distribution

neuron0 = [tICN(:,1), tICN(:,2)];

bin1 = 50; % for transformed ICN, in um.
size1 = 1000; % halfSpan of plotting surface size for ICN, in um

% Define bin centers for the 2D histogram
xEdges = -(size1+bin1/2):bin1:(size1+bin1/2);
yEdges = xEdges;

% Compute 2D histogram of ICN positions
neuron_2D = hist3(neuron0(:,1:2),{xEdges yEdges});

%% ICNS cluster area 
max_ICN_density = max(max(neuron_2D)); %Find the highest bin count in neuron_2D.
max_ICN_density_mmsquare = max(max(neuron_2D))*(1000/bin1)^2; %Convert peak count to units of counts per mm².

ICN_2D_image = uint8(neuron_2D);
level1 = 2/255; % minimum number of ICNs/50um2 for counting ICN area (>2 neurons per bin).
level2 = max_ICN_density*0.2/255; % 20% of max_ICN_density to define separate ICN clusters
level3 = max_ICN_density/2; % 50% of max_ICN_density to define separate peaks

% calculate ICN area
ICN_2D_area_BW  = im2bw(ICN_2D_image,level1);
ICN_2D_area = sum(sum(ICN_2D_area_BW));
figure;
imshow(ICN_2D_area_BW,'InitialMagnification',10000); % pass level 1

ICN_number_in_cluster = sum(sum(neuron_2D(neuron_2D>level1*255)));
ICN_density = ICN_number_in_cluster/ICN_2D_area;
ICN_2D_area_in_micron = ICN_2D_area*2500;

%% ICNS clusters
% get disconnected ICN clusters from 2D image using bwlabel function
ICN_2D_cluster_BW  = im2bw(ICN_2D_image,max(level1,level2)); %Threshold the image at the higher of level1 or level2, marking potential cluster regions.
[L,n] = bwlabel(ICN_2D_cluster_BW);
figure;
imshow(L, []);
%imshow(L,'InitialMagnification',10000);

% find locations of 2D peaks
[nRows,nCols] = size(neuron_2D);
ICN_2D_peak = [];
for i = 2:nRows-1
    for j = 2:nCols-1
        m = [level3,neuron_2D(i-1,j-1),...
            neuron_2D(i-1,j),...
            neuron_2D(i-1,j+1),...
            neuron_2D(i,j-1),...
            neuron_2D(i,j+1),...
            neuron_2D(i+1,j-1),...
            neuron_2D(i+1,j),...
            neuron_2D(i+1,j+1)];
        if neuron_2D(i,j)>max(m)
            ICN_2D_peak = [ICN_2D_peak;[i,j]]; %find local 2D peaks with threshold of level3
        end
    end
end
ICN_2D_cluster_temp = [];

% get ICN cluster identities for valued peaks
for i = 1:size(ICN_2D_peak,1)
    row = ICN_2D_peak(i,1);
    col = ICN_2D_peak(i,2);
    ICN_2D_cluster_temp = [ICN_2D_cluster_temp;L(row,col)];
end
ICN_2D_cluster_temp = unique(ICN_2D_cluster_temp);

% remove ICN clusters without peaks
ICN_2D_cluster_false = setdiff(1:n,ICN_2D_cluster_temp);
for i = 1:length(ICN_2D_cluster_false)
    L(L==ICN_2D_cluster_false(i)) = 0;
end

% relabel ICN cluster identities
for i = 1:length(ICN_2D_cluster_temp)
    L(L==ICN_2D_cluster_temp(i)) = i;
end

tICN_2D_cluster_number = length(ICN_2D_cluster_temp);
ICN_2D_cluster_map = flip(transpose(L));

figure;
h = imshow(ICN_2D_cluster_map,'InitialMagnification',10000);

%% Save file
save heart.mat




