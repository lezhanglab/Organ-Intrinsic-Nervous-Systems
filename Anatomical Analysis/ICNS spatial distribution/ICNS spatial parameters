%% Acronyms: ICNS, ICN, and ICNs are used interchangeably and refer to intrinsic cardiac neurons.

load heart.mat tICN tICN_2D_cluster_number rICN_distance

% calculate distance to 10 closest other ICNs
k = 10;
rICN_distance_nearest = mink(rICN_distance,k+1,2);
rICN_distance_nearest = mean(rICN_distance_nearest(:,2:k+1),2);












